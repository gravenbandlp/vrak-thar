---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { profilo } from '../data/scheda.ts';

const bg = await getEntry('pagine', 'background');
if (!bg) throw new Error('Manca src/content/pagine/background.md');
const { Content } = await render(bg);
const d = bg.data;

/* Percorso suggerito per l'immagine di un elemento di rilievo: si mostra nel segnaposto
   finche' il campo `img` di quella voce resta vuoto in background.md. */
function slugImg(titolo: string) {
  const slug = titolo
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
  return `/rilievi/${slug}.webp`;
}
---

<Layout titolo="Background" descrizione={d.intro}>

  <section>
    <div class="bar">
      <h2>{d.titolo}</h2>
      {d.nota && <span class="hint">{d.nota}</span>}
    </div>
    <div class="ident">
      <div class="portrait-frame lg">
        <img src={profilo.ritratto} alt={profilo.ritrattoAlt} width="900" height="900" />
      </div>
      <div>
        <h1 class="pname">{profilo.nome} <b>{profilo.cognome}</b></h1>
        <div class="psub">{d.sottotitolo}</div>
        <div class="idstats">
          {d.chip.map((c) => <span class="chip">{c.l} <b>{c.v}</b></span>)}
        </div>
        {d.intro && <div class="meta" style="margin-top:16px">{d.intro}</div>}
      </div>
    </div>
  </section>

  <section>
    <div class="bar"><h2>Storia</h2></div>
    <div class="panel prose">
      <Content />
    </div>
  </section>

  {d.rilievi.length > 0 && (
    <section>
      <div class="bar"><h2>Elementi di rilievo</h2><span class="hint">persone, luoghi, questioni aperte</span></div>
      <div class="rilievi">
        {d.rilievi.map((r) => (
          <article class="rilievo">
            <div class="ri-media">
              {r.img ? (
                <img src={r.img} alt={r.alt ?? r.t} loading="lazy" />
              ) : (
                <div class="ri-ph">
                  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <circle cx="8.5" cy="10" r="1.6" />
                    <path d="M4 17l5-5 3.5 3.5L16 12l4 4" />
                  </svg>
                  <span class="l">Immagine da inserire</span>
                  <code>public{slugImg(r.t)}</code>
                </div>
              )}
            </div>
            <div class="ri-body">
              <div class="m">{r.m}</div>
              <h3 class="t">{r.t}</h3>
              <p set:html={r.p} />
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

</Layout>
